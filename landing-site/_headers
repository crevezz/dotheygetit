# Netlify does not know what a .webmanifest is and serves it as
# application/octet-stream, which some browsers refuse to read as a manifest.
# Declaring it here fixes that at the edge, no server code involved.

/site.webmanifest
  Content-Type: application/manifest+json

# Icons and the social image are stable filenames, so let them cache for a week
# instead of re-downloading on every visit.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-16.png
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/android-chrome-192.png
  Cache-Control: public, max-age=604800
/android-chrome-512.png
  Cache-Control: public, max-age=604800
/android-chrome-maskable-512.png
  Cache-Control: public, max-age=604800
/mstile-150.png
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800
